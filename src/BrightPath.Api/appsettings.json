{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "BookingPolicy": {
    "TimeZone": "Asia/Ho_Chi_Minh",
    "CutoffLocalTime": "16:00",
    "LateCancellationWindow": "04:00:00",
    "MaxSessionsPerTutorPerDay": 6,
    "MaxAttendeesPerSession": 2,
    "ClosedDays": [ "Monday" ],
    "OpensAt": "09:00",
    "ClosesAt": "21:30"
  },
  "Seed": {
    "Enabled": true
  }
}
